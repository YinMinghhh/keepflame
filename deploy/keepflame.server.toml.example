# Server-only candidate: every task is disabled; no credentials are included.
# Recreate the venv and enroll/login locally on the server after authorization.
[storage]
path = "/Users/keepflame/Library/Application Support/KeepFlame/state/keepflame.sqlite3"

[[flames]]
id = "joinquant-primary"
keeper = "joinquant"
account_id = "primary"
enabled = false

[flames.schedule]
timezone = "Asia/Shanghai"
# Each day draws one uniform start in [09:00, 11:00), kept across restarts.
# A fixed `first_check = "09:00"` (instead of the window keys) still works.
first_window_start = "09:00"
first_window_end = "11:00"
# FAILED runs retry after 30, 60, 120 minutes, then stop for the day with one alert.
retry_minutes = [30, 60, 120]
recheck_minutes = 60
reminder_at = "20:00"
stop_at = "23:00"

[flames.settings]
mode = "browser"
task = "checkin"
browser_profile_dir = "/Users/keepflame/Library/Application Support/KeepFlame/profiles/joinquant-primary"
browser_headless = false

[[flames]]
id = "joinquant-reading-primary"
keeper = "joinquant"
account_id = "primary"
enabled = false

[flames.schedule]
timezone = "Asia/Shanghai"
# Drawn independently, but never earlier than 5 minutes after check-in that day.
first_window_start = "09:00"
first_window_end = "11:00"
after_flame = "joinquant-primary"
min_gap_minutes = 5
retry_minutes = [30, 60, 120]
recheck_minutes = 60
reminder_at = "20:00"
stop_at = "23:00"

[flames.settings]
mode = "browser"
task = "reading"
browser_profile_dir = "/Users/keepflame/Library/Application Support/KeepFlame/profiles/joinquant-primary"
browser_headless = false
# Articles are chosen by anonymous read-only discovery; no fixed list is needed.
reading_discovery = true
reading_discovery_max_requests = 30
# reading_wait_seconds = 50
# reading_scroll = true

# Email delivery exists and stays off. This candidate is not a live mailbox.
[notify.email]
enabled = false
host = "smtp.example.invalid"
port = 587
security = "starttls"
username = "keepflame@example.invalid"
password_file = "/Users/keepflame/Library/Application Support/KeepFlame/secrets/smtp.password"
from = "keepflame@example.invalid"
to = ["operator@example.invalid"]
timeout_seconds = 15

# Slack delivery exists and stays off. This candidate holds no real webhook address.
[notify.slack]
enabled = false
webhook_file = "/Users/keepflame/Library/Application Support/KeepFlame/secrets/slack-webhook.url"
timeout_seconds = 15

